{
	"manifest_version": 3,
	"browser_specific_settings": {
		"gecko": {
			"id": "password-factory@webExtension.arielg.il",
			"strict_min_version": "150.0",
			"data_collection_permissions": {
				"required": [ "none" ]
			}
		}
	},
	"name": "Password Factory",
	"version": "1.0",
	"description": "Generate strong & secure passwords instantly",
	"author": "arielg",
	"permissions": [
		"storage"
	],
	"icons": {
		"16": "/icon.svg",
		"32": "/icon.svg",
		"48": "/icon.svg"
	},
	"action": {
		"default_title": "Password Factory",
		"default_popup": "/popup.html",
		"default_icon": {
			"16": "/icon.svg",
			"32": "/icon.svg",
			"48": "/icon.svg"
		}
	}
}
